# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Used by API routes for score, XP and wallet writes (never exposed to the browser).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Public site URL, used for OAuth and email redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional. Secret mixed into the daily-challenge seed so outcomes can't be precomputed. Defaults to the service-role key.
DAILY_SEED_SECRET=
